# ── Groq (free tier) ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1500
GROQ_TEMPERATURE=0.2

# ── Embedding (local, no cost) ────────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_PATH=./knowledge_base/faiss_index
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── Database (shared MySQL with Laravel) ─────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=safepulse
DB_USER=safepulse
DB_PASS=your_db_password

# ── Security ──────────────────────────────────────────────────────────────
ADMIN_TOKEN=your_shared_admin_token
INTERNAL_TOKEN=your_internal_service_token

# ── Crawler schedule (cron syntax) ───────────────────────────────────────
CRAWLER_SCHEDULE=0 2 * * 0

# ── Session TTL (days) ───────────────────────────────────────────────────
SESSION_TTL_DAYS=7
